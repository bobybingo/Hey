# Spotify API credentials
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Must match a Redirect URI configured in your Spotify app
SPOTIFY_REDIRECT_URI=http://localhost:8080/spotify/callback

# Apple Music / MusicKit credentials
# Get these from https://developer.apple.com/account/resources/authkeys/list
APPLE_TEAM_ID=your_10_char_team_id
APPLE_KEY_ID=your_10_char_key_id
# Path to the .p8 private key file downloaded from Apple Developer
APPLE_PRIVATE_KEY_PATH=./AuthKey.p8

# Local server port (used for OAuth callbacks)
PORT=8080
